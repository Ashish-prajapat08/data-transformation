# Copy to .env locally. Never commit credentials.
# Select nvidia or openai when PLANNER_MODE=llm.
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# rules is an explicit offline baseline; llm enables semantic agent planning.
PLANNER_MODE=rules
DATABASE_URL=sqlite:///.runtime/migrations.db
# PostgreSQL alternative: postgresql+psycopg://USER:PASSWORD@HOST:5432/DB
FASTAPI_URL=http://127.0.0.1:8000
MAX_RETRIES=2
MAX_UPLOAD_BYTES=10485760

# Required by the public Docker/Render launcher. Optional for local Streamlit.
APP_PASSWORD=
